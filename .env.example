# このファイルは .env のサンプル。実際の値は .env に書き、.env はGitに含めない。
# プロジェクトをクローンしたら .env.example をコピーして .env を作る：
#   cp .env.example .env
# その後、各値を環境に合わせて変更すること。

# Django設定
# SECRET_KEYは以下のコマンドで生成：
#   docker compose run --rm web python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# 開発中のみTrue。本番では必ずFalse
DEBUG=True

# カンマ区切りでアクセス許可ホストを指定。本番では実ドメインに変更
ALLOWED_HOSTS=localhost,127.0.0.1

# 管理画面URL（攻撃者が /admin/ をスキャンするのを避けるため）
ADMIN_URL=admin/

# データベース設定（パスワードは32文字以上のランダム文字列推奨）
MYSQL_DATABASE=myblog
MYSQL_USER=blog_user
MYSQL_PASSWORD=change-this-to-strong-password
MYSQL_ROOT_PASSWORD=change-this-to-strong-password
DATABASE_URL=mysql://blog_user:change-this-to-strong-password@db:3306/myblog

# Google Analytics 4 測定ID（本番デプロイ後に設定）
# GA_TRACKING_ID=G-XXXXXXXXXX


# COCO AI会話。APIキーは.envだけに保存し、コミットしない。
# 本番は明示的に有効化するまで外部APIを呼ばない。
COCO_CHAT_ENABLED=False
OPENAI_API_KEY=
COCO_CHAT_MODEL=gpt-6-luna
# 非推論モデルに替える場合は空にして送信を省略できる。
COCO_CHAT_REASONING_EFFORT=none
COCO_CHAT_TIMEOUT_SECONDS=10
COCO_CHAT_MAX_OUTPUT_TOKENS=500
# 回数制限の初期値。移行後の日々の変更はバックヤード「COCO設定」で行う。
COCO_CHAT_PER_MINUTE=5
COCO_CHAT_PER_VISITOR_DAY=30
COCO_CHAT_GLOBAL_PER_DAY=100
COCO_CHAT_MAX_CONCURRENT=2
# サイト全体の短時間上限。読者別の上限はCOCO設定で変更します。
COCO_CHAT_GLOBAL_PER_MINUTE=20
# 直接runserverで使うときはFalse。Composeでは内部Nginxに合わせてTrueへ上書きします。
COCO_CHAT_TRUST_PROXY=False

# COCOの読み上げ。キーはサーバー用の.envにだけ保存する。
COCO_SPEECH_ENABLED=False
ELEVENLABS_API_KEY=
COCO_SPEECH_VOICE_ID=
COCO_SPEECH_MODEL=eleven_v4
