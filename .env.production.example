# ===========================================
# 本番環境用 .env のテンプレート
# ===========================================
# 使い方:
#   cp .env.production.example .env
#   nano .env  ← 各値を実際の本番用に書き換える
#   chmod 600 .env  ← 自分しか読めないようにする
#
# 各値の生成方法:
#   SECRET_KEY:
#     docker compose -f docker-compose.prod.yml run --rm web \
#       python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
#   パスワード・ADMIN_URL（32文字ランダム）:
#     openssl rand -base64 32
#     openssl rand -hex 16

# ===== Django設定 =====

# 50文字以上のランダム文字列。絶対に外部に漏らさない
SECRET_KEY=change-this-to-50-char-random-string

# 本番では絶対 False
DEBUG=False

# 自分のドメイン名（カンマ区切り・サブドメイン含めるなら追加）
ALLOWED_HOSTS=example.com,www.example.com

# CSRF対策。Django 4.0以降で必須
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# 管理画面URL（推測されにくいランダム文字列に。/で終わる）
ADMIN_URL=control-change-this-to-random/

# ===== データベース設定 =====

MYSQL_DATABASE=myblog
MYSQL_USER=blog_user
# 32文字以上のランダム英数字
MYSQL_PASSWORD=change-this-to-strong-32char-password
MYSQL_ROOT_PASSWORD=change-this-to-strong-32char-password
# 上の MYSQL_PASSWORD と同じパスワードを書く
DATABASE_URL=mysql://blog_user:change-this-to-strong-32char-password@db:3306/myblog

# ===== Google Analytics 4 =====
# GA4プロパティを作成したら測定IDを設定（例: G-XXXXXXXXXX）
# 未設定なら空のままでOK（GAタグは出力されない）
GA_TRACKING_ID=

# ===== Sentry エラー監視 =====
# https://sentry.io でプロジェクト作成して取得
SENTRY_DSN=
SENTRY_RELEASE=production-1.0


# COCO AI会話。APIキーは.envだけに保存し、コミットしない。
# 本番は明示的に有効化するまで外部APIを呼ばない。
COCO_CHAT_ENABLED=False
OPENAI_API_KEY=
COCO_CHAT_MODEL=gpt-6-luna
# 非推論モデルに替える場合は空にして送信を省略できる。
COCO_CHAT_REASONING_EFFORT=none
COCO_CHAT_TIMEOUT_SECONDS=10
COCO_CHAT_MAX_OUTPUT_TOKENS=500
# 回数制限の初期値。移行後の日々の変更はバックヤード「COCO設定」で行う。
COCO_CHAT_PER_MINUTE=5
COCO_CHAT_PER_VISITOR_DAY=30
COCO_CHAT_GLOBAL_PER_DAY=100
COCO_CHAT_MAX_CONCURRENT=2
# サイト全体の短時間上限。読者別の上限はCOCO設定で変更します。
COCO_CHAT_GLOBAL_PER_MINUTE=20
# 直接runserverで使うときはFalse。Composeでは内部Nginxに合わせてTrueへ上書きします。
COCO_CHAT_TRUST_PROXY=False

# COCOの読み上げ。キーはサーバー用の.envにだけ保存する。
COCO_SPEECH_ENABLED=False
ELEVENLABS_API_KEY=
COCO_SPEECH_VOICE_ID=
COCO_SPEECH_MODEL=eleven_v4
